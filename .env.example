# Copy to .env and fill what you need. Everything has a working default.

# --- Database ---
# Local default (no Docker needed):
DATABASE_URL=sqlite:///./neanderprompt.db
# Production example:
# DATABASE_URL=postgresql+psycopg://neander:neander@localhost:5432/neanderprompt

# --- Self-Healing RAG ---
CONFIDENCE_THRESHOLD=0.6
MAX_HEAL_ATTEMPTS=2

# Default model used when a request doesn't specify one.
# "echo-1" is fully offline (no key). Switch to any registry id below + its key.
DEFAULT_PROVIDER=echo
DEFAULT_MODEL=echo-1

# --- Provider API keys (only the ones you use) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=
# ZAI_API_KEY=
# MOONSHOT_API_KEY=
# XAI_API_KEY=
# DASHSCOPE_API_KEY=
